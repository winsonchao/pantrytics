# Google Gemini API Key (Free tier from https://aistudio.google.com/app/apikey)
# Can be configured on the server here, or directly in the web UI Settings page!
GEMINI_API_KEY=

# Default Model (Free tier fast recommendation: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Port configuration (default 3000)
PORT=3000

# Future Supabase Configuration (Optional - currently using Browser LocalStorage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
